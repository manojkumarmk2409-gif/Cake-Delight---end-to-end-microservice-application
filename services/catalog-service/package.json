{
    "name": "catalog-service",
    "version": "1.0.0",
    "description": "Cake catalog microservice",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "seed": "node src/seed.js",
        "test": "jest --forceExit --detectOpenHandles",
        "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
    },
    "dependencies": {
        "axios": "^1.7.2",
        "axios-retry": "^4.4.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "multer": "^2.2.0",
        "mysql2": "^3.11.3",
        "winston": "^3.13.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "mongodb-memory-server": "^10.0.0",
        "nodemon": "^3.1.4",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/*.test.js"
        ],
        "testTimeout": 30000
    }
}
