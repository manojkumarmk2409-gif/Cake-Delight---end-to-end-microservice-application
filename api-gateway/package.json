{
    "name": "api-gateway",
    "version": "1.0.0",
    "description": "API Gateway for Cake Delight",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --forceExit",
        "test:coverage": "jest --coverage --forceExit"
    },
    "dependencies": {
        "axios": "^1.7.2",
        "axios-retry": "^4.4.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "http-proxy-middleware": "^3.0.0",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.0",
        "winston": "^3.13.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.1.4",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/*.test.js"
        ]
    }
}
